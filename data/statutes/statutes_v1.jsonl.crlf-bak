{"act": "IPC", "section": "302", "title": "murder", "text_excerpt": "Whoever commits murder shall be punished with death, or imprisonment for life, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 103", "predecessor": null, "offence_cluster": "murder", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "103", "title": "murder", "text_excerpt": "Whoever commits murder shall be punished with death or imprisonment for life, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 302", "offence_cluster": "murder", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "304", "title": "culpable homicide not amounting to murder", "text_excerpt": "Whoever commits culpable homicide not amounting to murder shall be punished with imprisonment for life, or imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 105", "predecessor": null, "offence_cluster": "culpable_homicide", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "105", "title": "culpable homicide not amounting to murder", "text_excerpt": "Whoever commits culpable homicide not amounting to murder shall be punished with imprisonment for life, or imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 304", "offence_cluster": "culpable_homicide", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "379", "title": "theft (punishment)", "text_excerpt": "Whoever commits theft shall be punished with imprisonment of either description for a term which may extend to three years, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 303(2)", "predecessor": null, "offence_cluster": "theft", "consequence_class": "both", "verified": false}
{"act": "BNS", "section": "303(2)", "title": "theft (punishment)", "text_excerpt": "Whoever commits theft shall be punished with imprisonment of either description for a term which may extend to three years, or with fine, or with both.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 379", "offence_cluster": "theft", "consequence_class": "both", "verified": false}
{"act": "IPC", "section": "420", "title": "cheating and dishonestly inducing delivery of property", "text_excerpt": "Whoever cheats and thereby dishonestly induces the person deceived to deliver any property to any person shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 318(4)", "predecessor": null, "offence_cluster": "cheating", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "318(4)", "title": "cheating and dishonestly inducing delivery of property", "text_excerpt": "Whoever cheats and thereby dishonestly induces the person deceived to deliver any property to any person shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 420", "offence_cluster": "cheating", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "406", "title": "criminal breach of trust (punishment)", "text_excerpt": "Whoever commits criminal breach of trust shall be punished with imprisonment of either description for a term which may extend to three years, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 316(2)", "predecessor": null, "offence_cluster": "criminal_breach_of_trust", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "316(2)", "title": "criminal breach of trust (punishment)", "text_excerpt": "Whoever commits criminal breach of trust shall be punished with imprisonment of either description for a term which may extend to five years, or with fine, or with both.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 406", "offence_cluster": "criminal_breach_of_trust", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "307", "title": "attempt to murder", "text_excerpt": "Whoever does any act with such intention or knowledge, and under such circumstances that, if he by that act caused death, he would be guilty of murder, shall be punished with imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 109", "predecessor": null, "offence_cluster": "attempt_to_murder", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "109", "title": "attempt to murder", "text_excerpt": "Whoever does any act with such intention or knowledge, and under such circumstances that, if he by that act caused death, he would be guilty of murder, shall be punished with imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 307", "offence_cluster": "attempt_to_murder", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "498A", "title": "cruelty by husband or his relatives", "text_excerpt": "Whoever, being the husband or the relative of the husband of a woman, subjects such woman to cruelty shall be punished with imprisonment for a term which may extend to three years and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 85", "predecessor": null, "offence_cluster": "cruelty_by_husband", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "85", "title": "cruelty by husband or his relatives", "text_excerpt": "Whoever, being the husband or the relative of the husband of a woman, subjects such woman to cruelty shall be punished with imprisonment for a term which may extend to three years and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 498A", "offence_cluster": "cruelty_by_husband", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "506", "title": "criminal intimidation", "text_excerpt": "Whoever commits the offence of criminal intimidation shall be punished with imprisonment of either description for a term which may extend to two years, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 351(2)", "predecessor": null, "offence_cluster": "criminal_intimidation", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "351(2)", "title": "criminal intimidation", "text_excerpt": "Whoever commits the offence of criminal intimidation shall be punished with imprisonment of either description for a term which may extend to two years, or with fine, or with both.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 506", "offence_cluster": "criminal_intimidation", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "341", "title": "wrongful restraint (punishment)", "text_excerpt": "Whoever wrongfully restrains any person shall be punished with simple imprisonment for a term which may extend to one month, or with fine which may extend to five hundred rupees, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 126(2)", "predecessor": null, "offence_cluster": "wrongful_restraint", "consequence_class": "both", "verified": false}
{"act": "BNS", "section": "126(2)", "title": "wrongful restraint (punishment)", "text_excerpt": "Whoever wrongfully restrains any person shall be punished with simple imprisonment for a term which may extend to one month, or with fine which may extend to five thousand rupees, or with both.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 341", "offence_cluster": "wrongful_restraint", "consequence_class": "both", "verified": false}
{"act": "IPC", "section": "380", "title": "theft in a dwelling house", "text_excerpt": "Whoever commits theft in any building, tent or vessel, which building, tent or vessel is used as a human dwelling, or used for the custody of property, shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 305", "predecessor": null, "offence_cluster": "theft_in_dwelling", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "305", "title": "theft in a dwelling house", "text_excerpt": "Whoever commits theft in any building, tent or vessel, which building, tent or vessel is used as a human dwelling, or used for the custody of property, shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 380", "offence_cluster": "theft_in_dwelling", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "304B", "title": "dowry death", "text_excerpt": "Where the death of a woman is caused by burns or bodily injury, or occurs otherwise than under normal circumstances, within seven years of her marriage, and soon before her death she was subjected to cruelty or harassment for dowry, such death is called dowry death; her husband or his relative shall be punished with imprisonment for not less than seven years but which may extend to life.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 80", "predecessor": null, "offence_cluster": "cruelty_by_husband", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "80", "title": "dowry death", "text_excerpt": "Where the death of a woman is caused by burns or bodily injury, or occurs otherwise than under normal circumstances, within seven years of her marriage, and soon before her death she was subjected to cruelty or harassment for dowry, such death is called dowry death; her husband or his relative shall be punished with imprisonment for not less than seven years but which may extend to life.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 304B", "offence_cluster": "cruelty_by_husband", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "504", "title": "intentional insult with intent to provoke breach of peace", "text_excerpt": "Whoever intentionally insults, and thereby gives provocation to any person, intending or knowing it to be likely that such provocation will cause him to break the public peace, or to commit any offence, shall be punished with imprisonment of either description for a term which may extend to two years, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 352", "predecessor": null, "offence_cluster": "criminal_intimidation", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "352", "title": "intentional insult with intent to provoke breach of peace", "text_excerpt": "Whoever intentionally insults, and thereby gives provocation to any person, intending or knowing it to be likely that such provocation will cause him to break the public peace, or to commit any offence, shall be punished with imprisonment of either description for a term which may extend to two years, or with fine, or with both.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 504", "offence_cluster": "criminal_intimidation", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "342", "title": "wrongful confinement", "text_excerpt": "Whoever wrongfully confines any person shall be punished with imprisonment of either description for a term which may extend to one year, or with fine which may extend to one thousand rupees, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 127", "predecessor": null, "offence_cluster": "wrongful_restraint", "consequence_class": "both", "verified": false}
{"act": "BNS", "section": "127", "title": "wrongful confinement", "text_excerpt": "Whoever wrongfully confines any person shall be punished with imprisonment of either description for a term which may extend to one year, or with fine which may extend to five thousand rupees, or with both. Subsections (3)-(8) punish aggravated forms of wrongful confinement.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 342", "offence_cluster": "wrongful_restraint", "consequence_class": "both", "verified": false}
{"act": "IPC", "section": "378", "title": "theft (definition)", "text_excerpt": "Whoever, intending to take dishonestly any movable property out of the possession of any person without that person's consent, moves that property in order to such taking, is said to commit theft.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 303(1)", "predecessor": null, "offence_cluster": "theft", "consequence_class": "definition", "verified": false}
{"act": "BNS", "section": "303(1)", "title": "theft (definition)", "text_excerpt": "Whoever, intending to take dishonestly any movable property out of the possession of any person without that person's consent, moves that property in order to such taking, is said to commit theft.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 378", "offence_cluster": "theft", "consequence_class": "definition", "verified": false}
{"act": "IPC", "section": "384", "title": "extortion (punishment)", "text_excerpt": "Whoever commits extortion shall be punished with imprisonment of either description for a term which may extend to three years, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 308", "predecessor": null, "offence_cluster": "theft", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "308", "title": "extortion (punishment)", "text_excerpt": "Whoever commits extortion shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 384", "offence_cluster": "theft", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "304A", "title": "causing death by negligence", "text_excerpt": "Whoever causes the death of any person by doing any rash or negligent act not amounting to culpable homicide shall be punished with imprisonment of either description for a term which may extend to two years, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 106(1)", "predecessor": null, "offence_cluster": "culpable_homicide", "consequence_class": "both", "verified": false}
{"act": "BNS", "section": "106(1)", "title": "causing death by negligence", "text_excerpt": "Whoever causes death of a person by doing any rash or negligent act not amounting to culpable homicide shall be punished with imprisonment of either description for a term which may extend to five years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 304A", "offence_cluster": "culpable_homicide", "consequence_class": "both", "verified": false}
{"act": "IPC", "section": "405", "title": "criminal breach of trust (definition)", "text_excerpt": "Whoever, being in any manner entrusted with property, or with any dominion over property, dishonestly misappropriates or converts to his own use that property, commits criminal breach of trust.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 316(1)", "predecessor": null, "offence_cluster": "criminal_breach_of_trust", "consequence_class": "definition", "verified": false}
{"act": "BNS", "section": "316(1)", "title": "criminal breach of trust (definition)", "text_excerpt": "Whoever, being in any manner entrusted with property, or with any dominion over property, dishonestly misappropriates or converts to his own use that property, commits criminal breach of trust.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 405", "offence_cluster": "criminal_breach_of_trust", "consequence_class": "definition", "verified": false}
{"act": "IPC", "section": "409", "title": "criminal breach of trust by public servant, banker, merchant or agent", "text_excerpt": "Whoever, being in any manner entrusted with property, in the way of his employment as a public servant, banker, merchant, factor, broker, attorney or agent, commits criminal breach of trust in respect of that property, shall be punished with imprisonment for life, or with imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 316(4)", "predecessor": null, "offence_cluster": "criminal_breach_of_trust", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "316(4)", "title": "criminal breach of trust by public servant, banker, merchant or agent", "text_excerpt": "Whoever, being in any manner entrusted with property, in the way of his employment as a public servant, banker, merchant, factor, broker, attorney or agent, commits criminal breach of trust in respect of that property, shall be punished with imprisonment for life, or with imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 409", "offence_cluster": "criminal_breach_of_trust", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "306", "title": "abetment of suicide", "text_excerpt": "If any person commits suicide, whoever abets the commission of such suicide shall be punished with imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 108", "predecessor": null, "offence_cluster": "cruelty_by_husband", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "108", "title": "abetment of suicide", "text_excerpt": "If any person commits suicide, whoever abets the commission of such suicide shall be punished with imprisonment of either description for a term which may extend to ten years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 306", "offence_cluster": "cruelty_by_husband", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "417", "title": "cheating (punishment)", "text_excerpt": "Whoever cheats shall be punished with imprisonment of either description for a term which may extend to one year, or with fine, or with both.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 318(2)", "predecessor": null, "offence_cluster": "cheating", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "318(2)", "title": "cheating (punishment)", "text_excerpt": "Whoever cheats shall be punished with imprisonment of either description for a term which may extend to three years, or with fine, or with both.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 417", "offence_cluster": "cheating", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "468", "title": "forgery for purpose of cheating", "text_excerpt": "Whoever commits forgery, intending that the document forged shall be used for the purpose of cheating, shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 336", "predecessor": null, "offence_cluster": "cheating", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "336", "title": "forgery for purpose of cheating", "text_excerpt": "Whoever commits forgery, intending that the document forged shall be used for the purpose of cheating, shall be punished with imprisonment of either description for a term which may extend to seven years, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 468", "offence_cluster": "cheating", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "34", "title": "acts done by several persons in furtherance of common intention", "text_excerpt": "When a criminal act is done by several persons in furtherance of the common intention of all, each of such persons is liable for that act in the same manner as if it were done by him alone.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 3(5)", "predecessor": null, "offence_cluster": "criminal_intimidation", "consequence_class": "procedural", "verified": false}
{"act": "BNS", "section": "3(5)", "title": "acts done by several persons in furtherance of common intention", "text_excerpt": "When a criminal act is done by several persons in furtherance of the common intention of all, each of such persons is liable for that act in the same manner as if it were done by him alone.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 34", "offence_cluster": "criminal_intimidation", "consequence_class": "procedural", "verified": false}
{"act": "IPC", "section": "344", "title": "wrongful confinement for ten or more days", "text_excerpt": "Whoever wrongfully confines any person for ten days, or more, shall be punished with imprisonment of either description for a term which may extend to three years, and shall also be liable to fine.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 127(4)", "predecessor": null, "offence_cluster": "wrongful_restraint", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "127(4)", "title": "wrongful confinement for ten or more days", "text_excerpt": "Whoever wrongfully confines any person for ten days or more shall be punished with imprisonment of either description for a term which may extend to five years, and shall also be liable to fine which shall not be less than ten thousand rupees.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 344", "offence_cluster": "wrongful_restraint", "consequence_class": "custodial", "verified": false}
{"act": "IPC", "section": "345", "title": "wrongful confinement of person for whose liberation writ has been issued", "text_excerpt": "Whoever keeps any person in wrongful confinement, knowing that a writ for the liberation of that person has been duly issued, shall be punished with imprisonment of either description for a term which may extend to two years in addition to any term of imprisonment to which he may be liable under any other section of this Chapter.", "in_force_from": "1862-01-01", "in_force_until": "2024-07-01", "successor": "BNS 127(5)", "predecessor": null, "offence_cluster": "wrongful_restraint", "consequence_class": "custodial", "verified": false}
{"act": "BNS", "section": "127(5)", "title": "wrongful confinement of person for whose liberation writ has been issued", "text_excerpt": "Whoever keeps any person in wrongful confinement, knowing that a writ for the liberation of that person has been duly issued, shall be punished with imprisonment of either description for a term which may extend to two years in addition to any other term of imprisonment, and shall also be liable to fine.", "in_force_from": "2024-07-01", "in_force_until": null, "successor": null, "predecessor": "IPC 345", "offence_cluster": "wrongful_restraint", "consequence_class": "custodial", "verified": false}
